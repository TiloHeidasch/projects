# ---------------------------------------------------------
# CLOUDFLARE TUNNEL
# ---------------------------------------------------------
TUNNEL_TOKEN=your_value_here

# ---------------------------------------------------------
# OPENHANDS
# ---------------------------------------------------------
OPENHANDS_DATA_PATH=/mnt/user/appdata/openhands
OPENHANDS_PROJECTS_PATH=/mnt/user/appdata/openhands/projects
OPENHANDS_PORT=8000
OPENHANDS_LOCAL_BACKEND_API_KEY=your_value_here
OPENHANDS_SECRET_KEY=your_value_here
# Shared secret used to verify GitHub webhook signatures.
# The deployment operator must set a strong random value; never commit it.
AUTOMATION_WEBHOOK_SECRET=
