# ---------------------------------------------------------
# CLOUDFLARE TUNNEL
# ---------------------------------------------------------
# Put runtime values in the ignored .env on Unraid, not Git.
# This token is for the remotely managed Cloudflare Tunnel.
TUNNEL_TOKEN=your_value_here

# ---------------------------------------------------------
# MEEET
# ---------------------------------------------------------
# Private GHCR images require docker login ghcr.io on Unraid with read:packages access.
# Prefer a digest; the current runner tag is operator-selected and updateable.
MEEET_IMAGE=ghcr.io/tiloheidasch/meeet:sha-f6146db12b713bbfd47af8de0d16d3e1eeef72f0

# ---------------------------------------------------------
# PATHS
# ---------------------------------------------------------
# Must hold mvv-scheduled-artifact.json and its matching .v8.bin payload.
MEEET_SCHEDULE_HOST_DIR=/mnt/user/appdata/meeet/schedule
