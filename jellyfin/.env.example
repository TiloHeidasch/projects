# =============================================================================
# GENERAL
# =============================================================================

# User/Group IDs - auf Unraid typischerweise 99:100
PUID=99
PGID=100

# Zeitzone
TZ=Europe/Berlin

# Basispfad für alle Appdata (z.B. /mnt/user/appdata)
BASE_PATH=/mnt/user/appdata/

# Pfad zur Media-Share (z.B. /mnt/user/data)
MEDIA_SHARE=/mnt/user/video

# Downloads (Torrents + Usenet)
DOWNLOAD_PATH=/mnt/user/download

# Remote-Share (read-only für Jellyfin, read-write für Radarr)
REMOTE_SHARE=/mnt/remotes/aaa.bbb.ccc.ddd_video

# =============================================================================
# JELLYFIN
# =============================================================================

# Öffentliche URL über Cloudflare Tunnel
JELLYFIN_URL=your_value_here

# =============================================================================
# CLOUDFLARE TUNNEL
# =============================================================================

# Token aus dem Cloudflare Zero Trust Dashboard
# Dashboard → Networks → Tunnels → Create Tunnel → Token kopieren
CLOUDFLARE_TUNNEL_TOKEN=your_value_here

# =============================================================================
# VPN - GLUETUN (Standard: Mullvad + WireGuard)
# =============================================================================

VPN_SERVICE_PROVIDER=your_value_here
VPN_TYPE=wireguard

# WireGuard Private Key vom VPN-Anbieter
WIREGUARD_KEY=your_value_here

# WireGuard-Adresse vom VPN-Anbieter (z.B. 10.x.x.x/32)
WIREGUARD_ADD=your_value_here

# Bevorzugte VPN-Länder (kommagetrennt)
VPN_SERVER_COUNTRIES=your_value_here

# MTU - 1200 ist ein sicherer Standardwert
WIREGUARD_MTU=1200

# Port Forwarding - nur aktivieren wenn VPN-Anbieter es unterstützt
VPN_PORT_FORWARDING=off

# Torrenting Port (muss mit qBittorrent-Einstellung übereinstimmen)
TORRENTING_PORT=8694

# =============================================================================
# ARR API KEYS
# (zu finden unter Settings → General → Security in jeder App)
# =============================================================================

RADARR_KEY=your_value_here
SONARR_KEY=your_value_here

# =============================================================================
# SABNZBD
# =============================================================================

# Host-Whitelist für SABnzbd (z.B. deine Server-IP oder Domain)
HOST_WHITELIST_ENTRIES=your_value_here

