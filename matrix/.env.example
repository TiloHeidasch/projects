# ---------------------------------------------------------
# CLOUDFLARE TUNNEL
# ---------------------------------------------------------
TUNNEL_TOKEN=your_value_here

# ---------------------------------------------------------
# GENERAL
# ---------------------------------------------------------
BASE_PATH=/mnt/user/appdata
TZ=Europe/Berlin

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=your_value_here

# ---------------------------------------------------------
# BRIDGES DATABASE
# ---------------------------------------------------------
MAUTRIX_WHATSAPP_DB=mautrix_whatsapp
MAUTRIX_SIGNAL_DB=mautrix_signal

# ---------------------------------------------------------
# MATRIX / SYNAPSE
# ---------------------------------------------------------
MATRIX_SERVER_NAME=your_matrix_domain.tld
SYNAPSE_REPORT_STATS=no
SYNAPSE_ENABLE_REGISTRATION=no      # Wirkt NUR beim 'generate'-Befehl
                                    # Nachträgliche Änderung: homeserver.yaml editieren!
SYNAPSE_LOG_LEVEL=INFO

# ---------------------------------------------------------
# FIRST TIME SETUP
# ---------------------------------------------------------
#
# 1. Config generieren (einmalig):
#    docker compose run --rm \
#      -e SYNAPSE_SERVER_NAME=${MATRIX_SERVER_NAME} \
#      -e SYNAPSE_REPORT_STATS=no \
#      synapse generate
#
# 2. /mnt/user/appdata/matrix/synapse/homeserver.yaml editieren:
#    - database: auf PostgreSQL umstellen (psycopg2, host: database)
#    - redis: enabled: true, host: redis
#    - registration: enable_registration: true + enable_registration_without_verification: true
#      (ACHTUNG: nur für privaten/lokalen Betrieb, nie öffentlich!)
#
# 3. docker compose up -d
#
# Bridges (mautrix-whatsapp / mautrix-signal) nach gleichem Schema:
#   docker compose run --rm mautrix-whatsapp
#   → generiert /mnt/user/appdata/matrix/mautrix-whatsapp/config.yaml
#   → Datenbank in eigenen SQLite-Dateien unter /data
#   Registration muss in homeserver.yaml als app_service eingetragen werden