# ---------------------------------------------------------
# CLOUDFLARE TUNNEL
# ---------------------------------------------------------
TUNNEL_TOKEN=your_value_here

# ---------------------------------------------------------
# GENERAL
# ---------------------------------------------------------
BASE_PATH=/mnt/user/appdata
TZ=Europe/Berlin

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=your_value_here

# ---------------------------------------------------------
# MATRIX / SYNAPSE
# ---------------------------------------------------------
MATRIX_SERVER_NAME=your_matrix_domain.tld
SYNAPSE_REPORT_STATS=no
SYNAPSE_ENABLE_REGISTRATION=no
SYNAPSE_LOG_LEVEL=INFO

# ---------------------------------------------------------
# ELEMENT WEB - ERSTELLE config.json UNTER:
# ${BASE_PATH}/matrix/element/config.json
#
# Beispiel-Inhalt (deine Domain eintragen):
# {
#     "default_server_config": {
#         "m.homeserver": {
#             "base_url": "https://deine.domain.tld",
#             "server_name": "deine.domain.tld"
#         },
#         "m.identity_server": {
#             "base_url": "https://vector.im"
#         }
#     },
#     "disable_guests": false,
#     "brand": "Element"
# }
# ---------------------------------------------------------

# ---------------------------------------------------------
# ERSTELLUNG: EINMALIGER MANUELLER SCHRITT
#
# 1. docker compose up -d synapse
#    → generiert /mnt/user/appdata/matrix/synapse/homeserver.yaml
# 2. docker compose stop synapse
# 3. homeserver.yaml editieren:
#    a) database: auf PostgreSQL umstellen (unten stehende Config)
#    b) redis: aktivieren (unten stehende Config)
# 4. docker compose up -d
#
# Database-Konfiguration für homeserver.yaml:
#   database:
#     name: psycopg2
#     args:
#       user: synapse
#       password: DEIN_PASSWORT
#       database: synapse
#       host: database
#       port: 5432
#       cp_min: 5
#       cp_max: 10
#
# Redis-Konfiguration für homeserver.yaml:
#   redis:
#     enabled: true
#     host: redis
#     port: 6379
# ---------------------------------------------------------