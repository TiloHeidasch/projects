# ---------------------------------------------------------
# CLOUDFLARE TUNNEL
# ---------------------------------------------------------
TUNNEL_TOKEN=your_value_here

# ---------------------------------------------------------
# GENERAL
# ---------------------------------------------------------
BASE_PATH=/mnt/user/appdata
TZ=Europe/Berlin

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=your_value_here

# ---------------------------------------------------------
# MATRIX / SYNAPSE
# ---------------------------------------------------------
MATRIX_SERVER_NAME=your_matrix_domain.tld
SYNAPSE_REPORT_STATS=no
SYNAPSE_ENABLE_REGISTRATION=no
SYNAPSE_LOG_LEVEL=INFO

# ---------------------------------------------------------
# FIRST TIME SETUP
# ---------------------------------------------------------
#
# 1. Config generieren (einmalig):
#    docker compose run --rm \
#      -e SYNAPSE_SERVER_NAME=${MATRIX_SERVER_NAME} \
#      -e SYNAPSE_REPORT_STATS=no \
#      synapse generate
#
# 2. /mnt/user/appdata/matrix/synapse/homeserver.yaml editieren:
#    - database: auf PostgreSQL umstellen (psycopg2, host: database)
#    - redis: enabled: true, host: redis
#
# 3. docker compose up -d